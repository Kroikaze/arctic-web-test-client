{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "plugins": ["@trivago/prettier-plugin-sort-imports"],
    "importOrder": ["^react", "^@reduxjs", "^react-", "^@?\\w", "^[./]"],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
}
